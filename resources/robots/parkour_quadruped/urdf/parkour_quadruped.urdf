<?xml version="1.0" encoding="utf-8"?>
<!-- 基于绝影Lite3官方URDF修改 | 视觉使用圆柱/球体，运动学参数100%匹配Lite3.urdf -->
<robot name="Lite3_Simplified_Visual">
    <mujoco>
        <compiler meshdir="../meshes/" balanceinertia="false" discardvisual="false" fusestatic="false"/>
    </mujoco>
    
    <!-- 全局材质定义 -->
    <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
    </material>
    <material name="black">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
    </material>

    <!-- 躯干 TORSO | 尺寸: 0.55×0.22×0.13 -->
    <link name="TORSO">
        <inertial>
            <origin/>
            <mass value="5.6056"/>
            <inertia ixx="0.02456" ixy="0" ixz="0" iyy="0.05518" iyz="0" izz="0.07016"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.01"/>
            <geometry>
                <box size="0.55 0.22 0.13"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.01"/>
            <geometry>
                <box size="0.50 0.10 0.12"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 0.01"/>
            <geometry>
                <box size="0.25 0.20 0.12"/>
            </geometry>
        </collision>
    </link>

    <!-- ==================== 前左腿 Front Left Leg ==================== -->
    <!-- HIP | 球体视觉向外侧偏移 -->
    <link name="FL_HIP">
        <inertial>
            <origin xyz="-0.00601 -0.0066532 0.00034295"/>
            <mass value="0.550"/>
            <inertia ixx="0.0003949" ixy="0" ixz="0" iyy="0.0004028" iyz="0" izz="0.0004472"/>
        </inertial>
        <visual>
            <!-- 向外侧（Y轴正方向）偏移 0.08 米 -->
            <origin xyz="0 0.08 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0.05 0" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.04"/>
            </geometry>
        </collision>
    </link>

    <joint name="FL_HipX_joint" type="revolute">
        <origin xyz="0.1745 0.062 0"/>
        <parent link="TORSO"/>
        <child link="FL_HIP"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-0.523" upper="0.523" effort="24" velocity="26.2"/>
    </joint>

    <!-- THIGH | 长度 0.20，中心在 z=-0.10 -->
    <link name="FL_THIGH">
        <inertial>
            <origin xyz="-0.0039245 -0.014632 -0.025146"/>
            <mass value="0.86"/>
            <inertia ixx="0.005736" ixy="0" ixz="0" iyy="0.004960" iyz="0" izz="0.001436"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -0.10" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.20" radius="0.022"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="-0.015 0 -0.08"/>
            <geometry>
                <box size="0.04 0.045 0.20"/>
            </geometry>
        </collision>
    </link>

    <joint name="FL_HipY_joint" type="revolute">
        <origin xyz="0 0.09735 0"/>
        <parent link="FL_HIP"/>
        <child link="FL_THIGH"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.67" upper="0.314" effort="24" velocity="26.2"/>
    </joint>

    <!-- SHANK | 长度 0.21012，中心在 z=-0.10506 -->
    <link name="FL_SHANK">
        <inertial>
            <origin xyz="0.0064794 -1.4535E-06 -0.12157"/>
            <mass value="0.153"/>
            <inertia ixx="0.00089039" ixy="0" ixz="0" iyy="0.00090672" iyz="0" izz="3.1266E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -0.10506" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.21012" radius="0.015"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.005 0 -0.03" rpy="0 -0.2 0"/>
            <geometry>
                <cylinder length="0.12" radius="0.015"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0.01 0 -0.14" rpy="0 0.15 0"/>
            <geometry>
                <cylinder length="0.10" radius="0.015"/>
            </geometry>
        </collision>
    </link>

    <joint name="FL_Knee_joint" type="revolute">
        <origin xyz="0 0 -0.20"/>
        <parent link="FL_THIGH"/>
        <child link="FL_SHANK"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0.524" upper="2.792" effort="36" velocity="17.3"/>
    </joint>

    <!-- FOOT | 球体半径 0.022 -->
    <link name="FL_FOOT">
        <inertial>
            <mass value="0.02"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.022"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
            <geometry>
                <sphere radius="0.022"/>
            </geometry>
        </collision>
    </link>

    <joint name="FL_Ankle" type="fixed" dont_collapse="true">
        <parent link="FL_SHANK"/>
        <child link="FL_FOOT"/>
        <origin xyz="0 0 -0.21012"/>
    </joint>

    <!-- ==================== 前右腿 Front Right Leg ==================== -->
    <link name="FR_HIP">
        <inertial>
            <origin xyz="-0.010579 0.011358 0.00048546"/>
            <mass value="0.550"/>
